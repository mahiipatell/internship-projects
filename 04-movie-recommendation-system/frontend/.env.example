# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Must match backend TMDB_IMAGE_BASE_URL so image paths resolve correctly
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# If using the Cloudflare Worker proxy (see backend/.env.example), set this
# to the same worker URL's /t/p path, e.g. https://your-worker.workers.dev/t/p
