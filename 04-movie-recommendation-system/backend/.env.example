# ---------------------------------------------------
# Server
# ---------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------
# PostgreSQL (Prisma)
# ---------------------------------------------------
# Example: postgresql://USER:PASSWORD@localhost:5432/movie_rec_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_rec_db?schema=public"

# ---------------------------------------------------
# JWT
# ---------------------------------------------------
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=mrs_token

# ---------------------------------------------------
# TMDB API
# Get credentials at https://www.themoviedb.org/settings/api
# ---------------------------------------------------
TMDB_API_KEY=your_tmdb_v3_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# If your ISP resets connections to themoviedb.org directly (a known issue
# for some ISPs), deploy the proxy at scripts/tmdb-proxy-worker.js to
# Cloudflare Workers (free tier) and point these two URLs at it instead, e.g.:
#   TMDB_BASE_URL=https://your-worker.workers.dev/3
#   TMDB_IMAGE_BASE_URL=https://your-worker.workers.dev/t/p
