generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AnnouncementScope {
  INSTITUTION
  SECTION
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          Role
  firstName     String?
  lastName      String?
  // Account enabled flag. Drives login for every role (incl. PARENT/TEACHER,
  // which have no status of their own). Students use Student.active instead.
  active        Boolean @default(true)
  // password reset (inline to avoid an extra table)
  resetTokenHash     String?
  resetTokenExpiresAt DateTime?

  student      Student?      @relation("StudentAccount")
  teacher      Teacher?      @relation("TeacherAccount")
  children     Student[]     @relation("ParentChildren")
  refreshTokens RefreshToken[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Student {
  id         String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation("StudentAccount", fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  dob        DateTime?
  // Human-friendly roll number (e.g. "10A-01"). Unique within a section so two
  // classes can reuse "1", "2", … without colliding.
  rollNumber String
  sectionId  String?
  section    Section? @relation(fields: [sectionId], references: [id])
  parentId   String?
  parent     User?    @relation("ParentChildren", fields: [parentId], references: [id])
  active     Boolean  @default(true)

  attendances Attendance[]
  marks       Mark[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rollNumber, sectionId])
  @@index([sectionId])
}

model Teacher {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation("TeacherAccount", fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String

  teacherAssignments TeacherAssignment[]
  assignments        Assignment[]
  timetableSlots     TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id       String   @id @default(uuid())
  name     String
  sections Section[]

  classSubjects ClassSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id      String @id @default(uuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name    String

  students      Student[]
  exams         Exam[]
  assignments   Assignment[]
  teacherAssignments TeacherAssignment[]
  attendances   Attendance[]
  timetableSlots TimetableSlot[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
  @@index([classId])
}

model Subject {
  id    String @id @default(uuid())
  name  String
  code  String @unique

  classSubjects    ClassSubject[]
  teacherAssignments TeacherAssignment[]
  exams            Exam[]
  assignments      Assignment[]
  timetableSlots   TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSubject {
  id         String @id @default(uuid())
  classId    String
  class      Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([classId, subjectId])
}

model TeacherAssignment {
  id         String @id @default(uuid())
  teacherId  String
  teacher    Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, sectionId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section          @relation(fields: [sectionId], references: [id])
  date      DateTime
  status    AttendanceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([sectionId])
}

model Exam {
  id         String  @id @default(uuid())
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id])
  sectionId  String
  section    Section @relation(fields: [sectionId], references: [id])
  name       String
  maxMarks   Int
  examDate   DateTime?

  marks Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mark {
  id            String  @id @default(uuid())
  examId        String
  exam          Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student @relation(fields: [studentId], references: [id])
  marksObtained Float?
  published     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}

model Assignment {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Int?

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id             String  @id @default(uuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student @relation(fields: [studentId], references: [id])
  fileUrl        String?
  textContent    String?
  submittedAt    DateTime?
  marksObtained  Float?
  feedback       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
}

model TimetableSlot {
  id         String @id @default(uuid())
  sectionId  String
  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id])
  teacherId  String
  teacher    Teacher @relation(fields: [teacherId], references: [id])
  dayOfWeek  Int // 0=Sunday..6=Saturday
  period     Int

  createdAt DateTime @default(now())

  @@unique([teacherId, dayOfWeek, period])
  @@unique([sectionId, dayOfWeek, period])
}

model Announcement {
  id        String            @id @default(uuid())
  authorId  String
  author    User              @relation(fields: [authorId], references: [id])
  scope     AnnouncementScope
  sectionId String?
  section   Section?          @relation(fields: [sectionId], references: [id])
  title     String
  body      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}
